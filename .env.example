# ---- 제공사 선택 ----
# mock | hikerapi | apify   (키가 없으면 mock 으로 전체 파이프라인을 시험할 수 있음)
PRIMARY_PROVIDER=mock
# 주 제공사 장애·410 시 전환할 보조 제공사 (비우면 전환 안 함)
FALLBACK_PROVIDER=

# ---- HikerAPI ----
HIKERAPI_KEY=
HIKERAPI_BASE_URL=https://api.hikerapi.com
# /gql/topsearch (현행) | /v2/fbsearch/reels (2026-11-13 폐기 표시됨)
HIKERAPI_SEARCH_ENDPOINT=/gql/topsearch
# 호출 1회당 비용(USD) — PoC 실측 후 조정
HIKERAPI_COST_PER_CALL=0.001

# ---- Apify ----
APIFY_TOKEN=
APIFY_ACTOR=memo23~instagram-reels-search-scraper
APIFY_COST_PER_ITEM=0.0015

# ---- 저장소·DB ----
DATABASE_URL=sqlite:///./data/reels.db
STORAGE_DIR=./storage

# ---- 워커·정책 ----
SEARCH_WORKERS=2
DOWNLOAD_WORKERS=8
MAX_PAGES=20
PAGE_DELAY_MIN=1.0
PAGE_DELAY_MAX=2.0
RUN_TIMEOUT_MIN=15
VIDEO_RETENTION_DAYS=90
RAW_RETENTION_DAYS=30
METADATA_RETENTION_DAYS=365

# ---- 알림 ----
# Slack 호환 웹훅 (비우면 화면에만 표시)
ALERT_WEBHOOK_URL=
# PoC 실측 키워드당 비용(USD). 평균이 이 값의 2배를 넘으면 알림
BASELINE_COST_PER_KEYWORD=0.15

# ---- 접근 제어 (NFR-07) ----
# 둘 다 설정하면 HTTP Basic 인증으로 화면·영상 접근을 제한
APP_USER=
APP_PASSWORD=

# Mock 제공사가 영상 URL 을 만들 때 사용할 이 서버 주소
PUBLIC_BASE_URL=http://127.0.0.1:8000
